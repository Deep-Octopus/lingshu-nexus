# LingShu Nexus local development configuration.
# Copy to `.env` and replace placeholder values before running real services.

APP_ENV=development
APP_NAME="LingShu Nexus"
APP_HOST=0.0.0.0
APP_PORT=8000
DEFAULT_DOMAIN_ID=acupuncture

# Active extraction provider: deepseek or mimo.
LLM_PROVIDER=deepseek

# DeepSeek OpenAI-compatible provider. Do not commit real keys.
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_ID=deepseek-v4-flash
DEEPSEEK_EXTRACTION_MODEL_ID=
DEEPSEEK_CHAT_MODEL_ID=
DEEPSEEK_TIMEOUT_SECONDS=45

# Optional MiMo provider configuration for LLM_PROVIDER=mimo.
MIMO_API_KEY=replace-with-mimo-api-key
MIMO_BASE_URL=https://mimo.example.invalid/v1
MIMO_MODEL_ID=replace-with-mimo-model-id
MIMO_EXTRACTION_MODEL_ID=
MIMO_CHAT_MODEL_ID=
MIMO_TIMEOUT_SECONDS=45

# Business database.
DATABASE_URL=postgresql://lingshu:change-me-postgres-password@localhost:5432/lingshu_nexus

# Queue/cache.
REDIS_URL=redis://localhost:6379/0

# Object storage.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=lingshu-documents
OBJECT_STORAGE_LOCAL_PATH=data/runtime/object-store
OBJECT_STORAGE_ACCESS_KEY=replace-with-minio-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-minio-secret-key
OBJECT_STORAGE_SECURE=false

# Upload limits.
DOCUMENT_MAX_UPLOAD_BYTES=20971520

# Agent Skill Registry.
SKILL_REGISTRY_PATH=skills

# Frontend API base used by Vite runtime. Leave unset in local dev to use the
# Vite proxy, or set it to an absolute API URL when serving the frontend
# separately.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Vite dev-server proxy target for /api/v1 when VITE_API_BASE_URL is unset.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Graph database.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password
